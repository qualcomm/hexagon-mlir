// CHECK: #[[$ATTR_1:.+]] = affine_map<(d0, d1, d2, d3, d4, d5, d6, d7) -> (d3, d6)>
// CHECK-LABEL:   func.func @multiuse_generic(
// CHECK-SAME:      %[[ARG0:.*]]: tensor<1x7x1x768xf16>,
// CHECK-SAME:      %[[ARG1:.*]]: tensor<768xf16>,
// CHECK-SAME:      %[[ARG2:.*]]: tensor<3072x1x1x768xf16>) -> tensor<1x7x1x3072xf16> {
// CHECK:           %[[VAL_0:.*]] = arith.constant 0.000000e+00 : f16
// CHECK:           %[[VAL_1:.*]] = tensor.empty() : tensor<1x1x1x24x8x4x32xf16>
// CHECK:           %[[VAL_2:.*]] = linalg.pack %[[ARG0]] padding_value(%[[VAL_0]] : f16) inner_dims_pos = [1, 2, 3]
// CHECK-SAME:      inner_tiles = [8, 4, 32] into %[[VAL_1]] :
// CHECK-SAME:      tensor<1x7x1x768xf16> -> tensor<1x1x1x24x8x4x32xf16>
// CHECK:           %[[VAL_3:.*]] = tensor.empty() : tensor<24x32xf16>
// CHECK:           %[[VAL_4:.*]] = linalg.pack %[[ARG1]] inner_dims_pos = [0]
// CHECK-SAME:      inner_tiles = [32] into %[[VAL_3]] :
// CHECK-SAME:      tensor<768xf16> -> tensor<24x32xf16>
// CHECK:           %[[VAL_5:.*]] = tensor.empty() : tensor<1x1x1x24x8x2x32x2xf16>
// CHECK:           %[[VAL_6:.*]] = tensor.empty() : tensor<1x1x1x24x8x2x32x2xf16>
// CHECK-NEXT:      %[[VAL_7:.*]] = linalg.pack %[[VAL_2]] inner_dims_pos = [5] inner_tiles = [2]
// CHECK-SAME:      into %[[VAL_6]] : tensor<1x1x1x24x8x4x32xf16> -> tensor<1x1x1x24x8x2x32x2xf16>
// CHECK-NEXT:      %[[VAL_8:.*]] = linalg.generic {indexing_maps = [#[[$ATTR_0]], #[[$ATTR_1]], #[[$ATTR_0]]],
// CHECK-SAME:      iterator_types = ["parallel", "parallel", "parallel", "parallel", "parallel", "parallel", "parallel", "parallel"]}
// CHECK-SAME:      ins(%[[VAL_7]], %[[VAL_4]] : tensor<1x1x1x24x8x2x32x2xf16>, tensor<24x32xf16>)
// CHECK-SAME:      outs(%[[VAL_5]] : tensor<1x1x1x24x8x2x32x2xf16>) {
// CHECK-NEXT:      ^bb0(%[[VAL_9:.*]]: f16, %[[VAL_10:.*]]: f16, %[[VAL_11:.*]]: f16):
// CHECK-NEXT:        %[[VAL_12:.*]] = arith.addf %[[VAL_9]], %[[VAL_10]] : f16
// CHECK-NEXT:        linalg.yield %[[VAL_12]] : f16
// CHECK-NEXT:      } -> tensor<1x1x1x24x8x2x32x2xf16>
// CHECK:           return %[[VAL_20:.*]] : tensor<1x7x1x3072xf16>
// CHECK-NEXT:    }

