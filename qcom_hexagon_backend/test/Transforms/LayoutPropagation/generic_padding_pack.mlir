// RUN: linalg-hexagon-opt %s -pass-pipeline='builtin.module(func.func(extend-pack-frontier{parallels-only=false}))' | FileCheck %s --check-prefixes=CHECK
// This test pushes linalg.pack with padding values above the multi-result linalg.generic {...extf..}.

#map = affine_map<(d0, d1, d2, d3) -> (d0, d1, d2, d3)>
#map1 = affine_map<(d0, d1, d2, d3) -> (d3)>
func.func @multiuse_generic(%arg0: tensor<1x7x1x768xf16>, %arg1: tensor<768xf16>, %arg2: tensor<3072x1x1x768xf16>) -> (tensor<1x7x1x3072xf16>) {
    %21 = tensor.empty() : tensor<1x7x1x768xf16>
    %22 = linalg.generic {indexing_maps = [#map, #map1, #map], 
      iterator_types = ["parallel", "parallel", "parallel", "parallel"]}
      ins(%arg0, %arg1 : tensor<1x7x1x768xf16>, tensor<768xf16>)
      outs(%21 : tensor<1x7x1x768xf16>) {
    ^bb0(%in: f16, %in_27: f16, %out: f16):
      %39 = arith.addf %in, %in_27 : f16
      linalg.yield %39 : f16
    } -> tensor<1x7x1x768xf16>
    %cst_11 = arith.constant 0.000000e+00 : f16
    %28 = tensor.empty() : tensor<1x1x1x24x8x4x32xf16>
    %pack_12 = linalg.pack %22 padding_value(%cst_11 : f16) inner_dims_pos = [1, 2, 3] inner_tiles = [8, 4, 32] into %28 :
    tensor<1x7x1x768xf16> -> tensor<1x1x1x24x8x4x32xf16>
    %29 = tensor.empty() : tensor<1x1x1x24x8x2x32x2xf16>
    %pack_13 = linalg.pack %pack_12 inner_dims_pos = [5] inner_tiles = [2] into %29 :
    tensor<1x1x1x24x8x4x32xf16> -> tensor<1x1x1x24x8x2x32x2xf16>
    %30 = builtin.unrealized_conversion_cast %pack_13 : tensor<1x1x1x24x8x2x32x2xf16> to tensor<1x7x1x768xf16>
    %33 = tensor.empty() : tensor<1x7x1x3072xf16>
    %34 = linalg.conv_2d_nhwc_fhwc ins(%30, %arg2 : tensor<1x7x1x768xf16>, tensor<3072x1x1x768xf16>)
    outs(%33 : tensor<1x7x1x3072xf16>) -> tensor<1x7x1x3072xf16>
    %35 = builtin.unrealized_conversion_cast %34 : tensor<1x7x1x3072xf16> to tensor<1x1x1x96x8x2x32x2xf16>
    %36 = tensor.empty() : tensor<1x1x1x96x8x4x32xf16>
    %unpack_24 = linalg.unpack %35 inner_dims_pos = [5] inner_tiles = [2] into %36 :
    tensor<1x1x1x96x8x2x32x2xf16> -> tensor<1x1x1x96x8x4x32xf16>
    %37 = tensor.empty() : tensor<1x7x1x3072xf16>
    %unpack_25 = linalg.unpack %unpack_24 inner_dims_pos = [1, 2, 3] inner_tiles = [8, 4, 32] into %37 :
    tensor<1x1x1x96x8x4x32xf16> -> tensor<1x7x1x3072xf16>
    return %unpack_25 : tensor<1x7x1x3072xf16>
}
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// The script is designed to make adding checks to
// a test case fast, it is *not* designed to be authoritative
// about what constitutes a good test! The CHECK should be
// minimized and named to reflect the test intent.



