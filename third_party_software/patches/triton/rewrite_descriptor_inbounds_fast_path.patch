+// Returns a scalar i1 that is true iff the whole block is in bounds in every
+// dimension, i.e. for all i:
+//   offsets[i] >= 0  &&  offsets[i] + (blockShape[i] - 1) < shape[i]
+// This is exactly the condition under which generateMask() would be all-true,
+// so callers may take an unmasked fast path when it holds. The check is built
+// from cheap scalar comparisons rather than the per-element tensor mask.
+Value generateInBoundsCheck(OpBuilder &builder, const Location &loc,
+                            ArrayRef<std::int64_t> blockShape, Descriptor &desc,
+                            ValueRange offsets) {
+  assert(blockShape.size() == desc.shape.size());
+  assert(blockShape.size() == offsets.size());
+  auto i64Ty = builder.getI64Type();
+  Value zero = arith::ConstantIntOp::create(builder, loc, i64Ty, 0);
+  // Initialize to true so rank-0 is safe and a fully-static block folds away.
+  Value inBounds =
+      arith::ConstantIntOp::create(builder, loc, builder.getI1Type(), 1);
+  for (std::size_t i = 0; i < blockShape.size(); ++i) {
+    // offsets[i] >= 0
+    Value cmpLower = arith::CmpIOp::create(
+        builder, loc, arith::CmpIPredicate::sge, offsets[i], zero);
+    // offsets[i] + (blockShape[i] - 1) < shape[i]
+    Value blockMax =
+        arith::ConstantIntOp::create(builder, loc, i64Ty, blockShape[i] - 1);
+    Value hi = arith::AddIOp::create(builder, loc, offsets[i], blockMax);
+    Value cmpUpper = arith::CmpIOp::create(
+        builder, loc, arith::CmpIPredicate::slt, hi, desc.shape[i]);
+    Value dimInBounds =
+        arith::AndIOp::create(builder, loc, cmpLower, cmpUpper);
+    inBounds = arith::AndIOp::create(builder, loc, inBounds, dimInBounds);
+  }
+  return inBounds;
+}
