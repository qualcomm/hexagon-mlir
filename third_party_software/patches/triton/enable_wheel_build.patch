+def copy_path(src: Path, dst: Path, *, ignore=None):
+    if dst.exists() or dst.is_symlink():
+        if dst.is_dir() and not dst.is_symlink():
+            shutil.rmtree(dst)
+        else:
+            dst.unlink()
+    if not src.exists():
+        raise FileNotFoundError(f"Required wheel artifact does not exist: {src}")
+    print(f"copying wheel artifact: {dst} <- {src}", file=sys.stderr)
+    if src.is_dir():
+        shutil.copytree(src, dst, symlinks=True, ignore=ignore)
+    else:
+        dst.parent.mkdir(parents=True, exist_ok=True)
+        shutil.copy2(src, dst)
+
+
+def is_hexagon_mlir_wheel():
