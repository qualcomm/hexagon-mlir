+def get_build_dependency_metadata():
+    keys = ["HEXAGON_TOOLS_VERSION", "HEXAGON_ARCH_VERSION", "HEXAGON_SDK_VERSION"]
+    return {key: os.environ.get(key, "") for key in keys}
+
+
+def write_build_metadata(build_lib: str):
